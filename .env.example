# ──────────────────────────────────────────────────────────────────────────────
# Universal Automation Backend – environment template
# Copy to `.env.local` for development. On Vercel add the same keys under
# Project → Settings → Environment Variables. NEVER commit real values.
# Every key is optional unless marked REQUIRED; missing keys degrade gracefully.
# ──────────────────────────────────────────────────────────────────────────────

# ── Security / CORS ───────────────────────────────────────────────────────────
# CORS is universal (`*`) so any current or future landing-page domain can call this API.
# ALLOWED_ORIGINS is informational (logging / future tighter modes) and never blocks a browser.
ALLOWED_ORIGINS=*
ALLOW_LOCALHOST_ORIGINS=true
# Send as header `x-api-key: <value>`. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
# Upstash Redis (recommended on Vercel – shared across serverless instances; also powers idempotency
# and slot locks). Without it the app falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STRICT_PER_MINUTE=20
MAX_BODY_BYTES=262144

# ── Response contract ─────────────────────────────────────────────────────────
# Keep legacy top-level fields (reply, appointment, …) next to `data` for older clients.
API_LEGACY_FIELDS=true
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# ── AI concierge (/api/ai-chat) ───────────────────────────────────────────────
# Low temperature keeps answers factual and on-topic (0.3 - 0.5 recommended).
AI_CHAT_TEMPERATURE=0.4
# Total time budget per reply across all keys; if exceeded the smart fallback answers instead (keep < host limit).
AI_CHAT_BUDGET_MS=8500
# Cache card-click opener replies (seconds, 0 = off). Uses Upstash Redis when configured.
AI_CHAT_OPENER_CACHE_SECONDS=900
# Set false to ignore `businessContext` sent by landing pages and only use server-side knowledge.
AI_ALLOW_CLIENT_BUSINESS_CONTEXT=true
# Per-niche business knowledge as one-line JSON (overrides the built-in profile; payload businessContext overrides this).
# Fields: brandName, expertName, expertTitle, industry, tagline, location, phone, hours, pricingGuidelines, bookingOptions,
#         tone, notes, highlights[], services[{name,summary,price?,keywords?[]}]
# DENTAL_BUSINESS_CONTEXT={"hours":"Mon-Fri 8am-6pm","phone":"(555) 234-7890"}
# SOLAR_BUSINESS_CONTEXT={"brandName":"BrightRoof Solar","expertName":"Maria Lopez","industry":"residential solar installation"}
# REAL_ESTATE_BUSINESS_CONTEXT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=
PUBLIC_BASE_URL=https://your-backend.vercel.app
STAFF_PHONE_NUMBER=
EMERGENCY_MANAGER_PHONE=
EMERGENCY_DOCTOR_PHONE=
SOLAR_TEAM_PHONE=
ROOFING_TEAM_PHONE=
REAL_ESTATE_TEAM_PHONE=

# ── Retell AI voice agents (RETELL_<NICHE>_AGENT_ID falls back to RETELL_AGENT_ID) ─
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_DENTAL_AGENT_ID=
RETELL_SOLAR_AGENT_ID=
RETELL_ROOFING_AGENT_ID=
RETELL_REAL_ESTATE_AGENT_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
